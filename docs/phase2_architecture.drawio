        <mxCell id="t3_events" value="Table: campus_events&#xa;----------------------------&#xa;• id: INT AUTO_INCREMENT [PK]&#xa;• title: VARCHAR(150)&#xa;• speaker_name: VARCHAR(100)&#xa;• speaker_title: VARCHAR(100)&#xa;• department: VARCHAR(80)&#xa;• venue: VARCHAR(100)&#xa;• event_date: DATETIME&#xa;• total_seats: INT&#xa;• registered_seats: INT" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=0;align=left;fillColor=#FFFBEB;strokeColor=#FDE68A;fontSize=11;spacingLeft=8;" vertex="1" parent="1">
