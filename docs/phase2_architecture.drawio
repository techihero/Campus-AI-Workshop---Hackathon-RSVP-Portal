        <!-- Header Title Banner -->
        <mxCell id="title" value="Campus AI Workshop &amp; Hackathon RSVP Portal&#xa;3-Tier Production Architecture (5500 -> 8080 -> 3306)" style="text;html=1;strokeColor=#CBD5E1;fillColor=#F8FAFC;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=20;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="810" height="55" as="geometry" />
        </mxCell>

        <!-- TIER 1: Presentation Layer -->
        <mxCell id="tier1_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="320" height="470" as="geometry" />
        </mxCell>
        <mxCell id="tier1_title" value="Tier 1: Presentation Layer&#xa;Port 5500 (Live Server / Python Runner)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284C7;fontColor=#FFFFFF;fontStyle=1;fontSize=14;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="50" y="110" width="300" height="45" as="geometry" />
        </mxCell>
        
        <mxCell id="t1_html" value="Semantic HTML5 Client&#xa;• &lt;header&gt; symposium hero &amp; badges&#xa;• Auto-fill Workshop Cards Grid&#xa;• Accessible &lt;dialog&gt; RSVP Modal&#xa;• Live Attendee Headcount &lt;table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BAE6FD;align=left;spacingLeft=12;fontSize=12;fontColor=#0369A1;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="280" height="85" as="geometry" />
        </mxCell>
        
        <mxCell id="t1_css" value="Styling: Glassmorphism &amp; CSS Grid&#xa;• Dark Theme: Deep Navy &amp; Slate&#xa;• Glowing Neon Status Badges&#xa;• Real-time Seat Progress Meters&#xa;• backdrop-filter: blur(16px)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BAE6FD;align=left;spacingLeft=12;fontSize=12;fontColor=#0369A1;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="280" height="85" as="geometry" />
        </mxCell>
        
        <mxCell id="t1_js" value="Reactive Logic (Vanilla JS ES6)&#xa;• api.js: Fetch Client (Spring / Fallback)&#xa;• app.js: DOM Binding &amp; State&#xa;• Live Ticket Headroom Validation&#xa;• One-click RSVP Cancellation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BAE6FD;align=left;spacingLeft=12;fontSize=12;fontColor=#0369A1;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="280" height="85" as="geometry" />
        </mxCell>
        
        <mxCell id="t1_users" value="Student Attendees &amp; Coordinators&#xa;(Chrome, Edge, Safari, Mobile)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#7DD3FC;fontStyle=1;fontSize=12;fontColor=#0284C7;" vertex="1" parent="1">
          <mxGeometry x="60" y="475" width="280" height="40" as="geometry" />
        </mxCell>

        <!-- TIER 2: Application / Logic -->
        <mxCell id="tier2_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="330" height="470" as="geometry" />
        </mxCell>
        <mxCell id="tier2_title" value="Tier 2: Business Logic Layer&#xa;Spring Boot 3 REST API (Port 8080)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16A34A;fontColor=#FFFFFF;fontStyle=1;fontSize=14;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="430" y="110" width="310" height="45" as="geometry" />
        </mxCell>

        <mxCell id="t2_controllers" value="REST Controllers&#xa;• RegistrationController&#xa;  - POST /api/registrations (201, 400, 409)&#xa;  - GET /api/registrations (Live Roster)&#xa;  - DELETE /api/registrations/{id} (Restores Seats)&#xa;• CampusEventController&#xa;  - GET /api/events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBF7D0;align=left;spacingLeft=12;fontSize=12;fontColor=#15803D;" vertex="1" parent="1">
          <mxGeometry x="435" y="170" width="300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="t2_service" value="Service Layer (@Transactional)&#xa;• RsvpService&#xa;  - Duplicate Email Guard (HTTP 409)&#xa;  - Capacity Lock (registered_seats + tickets &lt;= total)&#xa;  - Strict 1–2 Ticket Quota Enforcement&#xa;• GlobalExceptionHandler (@ControllerAdvice)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBF7D0;align=left;spacingLeft=12;fontSize=12;fontColor=#15803D;" vertex="1" parent="1">
          <mxGeometry x="435" y="295" width="300" height="105" as="geometry" />
        </mxCell>

        <mxCell id="t2_jpa" value="Spring Data JPA &amp; Persistence&#xa;• CampusEventRepository&#xa;• RegistrationRepository&#xa;• Hibernate ORM + Hikari Connection Pool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBF7D0;align=left;spacingLeft=12;fontSize=12;fontColor=#15803D;" vertex="1" parent="1">
          <mxGeometry x="435" y="415" width="300" height="65" as="geometry" />
        </mxCell>

        <mxCell id="t2_runtime" value="Java 17 (Microsoft OpenJDK) • Spring Boot 3.2.5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#86EFAC;fontStyle=1;fontSize=12;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="435" y="495" width="300" height="30" as="geometry" />
        </mxCell>

        <!-- TIER 3: Database Engine -->
        <mxCell id="tier3_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="100" width="320" height="470" as="geometry" />
        </mxCell>
        <mxCell id="tier3_title" value="Tier 3: Database Layer&#xa;MySQL 8.4 Server (Port 3306)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D97706;fontColor=#FFFFFF;fontStyle=1;fontSize=14;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="820" y="110" width="300" height="45" as="geometry" />
        </mxCell>

        <mxCell id="t3_events" value="Table: campus_events&#xa;---------------------------------&#xa;• id: INT AUTO_INCREMENT [PK]&#xa;• title: VARCHAR(150)&#xa;• description: TEXT&#xa;• speaker_name: VARCHAR(100)&#xa;• speaker_title: VARCHAR(120)&#xa;• department: VARCHAR(80)&#xa;• venue: VARCHAR(120)&#xa;• event_date: DATETIME&#xa;• total_seats: INT&#xa;• registered_seats: INT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;align=left;spacingLeft=12;fontSize=11;fontColor=#B45309;" vertex="1" parent="1">
          <mxGeometry x="825" y="170" width="290" height="155" as="geometry" />
        </mxCell>

        <mxCell id="t3_registrations" value="Table: registrations&#xa;---------------------------------&#xa;• id: BIGINT AUTO_INCREMENT [PK]&#xa;• event_id: INT [FK -> campus_events.id]&#xa;• attendee_name: VARCHAR(100)&#xa;• attendee_email: VARCHAR(150)&#xa;• department: VARCHAR(80)&#xa;• tickets: INT (CHECK tickets IN (1, 2))&#xa;• registered_at: TIMESTAMP&#xa;---------------------------------&#xa;• CONSTRAINT uk_event_email UNIQUE(event_id, attendee_email)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;align=left;spacingLeft=12;fontSize=11;fontColor=#B45309;" vertex="1" parent="1">
          <mxGeometry x="825" y="340" width="290" height="150" as="geometry" />
        </mxCell>

        <mxCell id="t3_engine" value="InnoDB Storage Engine • ACID Compliant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#FCD34D;fontStyle=1;fontSize=12;fontColor=#92400E;" vertex="1" parent="1">
          <mxGeometry x="825" y="505" width="290" height="30" as="geometry" />
        </mxCell>

        <!-- Connectors -->
        <mxCell id="conn_1_2" value="HTTP / JSON&#xa;CORS Enabled&#xa;Port 5500 &rarr; 8080" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=3;fontColor=#0369A1;fontSize=12;fontStyle=1;" edge="1" parent="1" source="tier1_bg" target="tier2_bg">
          <mxGeometry y="25" relative="1" as="geometry">
