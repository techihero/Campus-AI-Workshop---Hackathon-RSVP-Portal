        <!-- Footer / Rules -->
        <mxCell id="footer" value="Core Technical Guarantees: (1) UNIQUE(event_id, attendee_email) eliminates duplicate bookings. (2) Atomic transactions prevent overbooking beyond auditorium capacity. (3) 1–2 seat limit enforced both client-side and server-side." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#475569;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="1090" height="35" as="geometry" />
        </mxCell>

      </root>
