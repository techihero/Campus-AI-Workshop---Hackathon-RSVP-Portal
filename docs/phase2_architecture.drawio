        </mxCell>
        
        <mxCell id="t2_service" value="Service &amp; Validation Layer&#xa;• RsvpService (@Transactional)&#xa;  - Duplicate email verification&#xa;  - Capacity headroom enforcement&#xa;  - Atomic seat count increment/decrement&#xa;• GlobalExceptionHandler (@ControllerAdvice)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="275" width="280" height="100" as="geometry" />
