  </diagram>

  <!-- PAGE 2: ENTITY RELATIONSHIP DIAGRAM -->
  <diagram id="page-erd" name="2. Database ER Diagram">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="erd_title" value="Campus AI RSVP Portal - Relational Schema &amp; ER Diagram (MySQL 8.4)" style="text;html=1;strokeColor=#CBD5E1;fillColor=#F8FAFC;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="230" y="30" width="710" height="50" as="geometry" />
        </mxCell>

        <!-- Event Entity -->
        <mxCell id="entity_event" value="campus_events&#xa;[Primary Workshop Master]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284C7;fontColor=#FFFFFF;fontStyle=1;fontSize=14;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="120" y="130" width="360" height="40" as="geometry" />
        </mxCell>
        <mxCell id="event_fields" value="PK | id                 : INT AUTO_INCREMENT&#xa;   | title              : VARCHAR(150) NOT NULL&#xa;   | description        : TEXT NOT NULL&#xa;   | speaker_name       : VARCHAR(100) NOT NULL&#xa;   | speaker_title      : VARCHAR(120) NOT NULL&#xa;   | department         : VARCHAR(80) NOT NULL&#xa;   | venue              : VARCHAR(120) NOT NULL&#xa;   | event_date         : DATETIME NOT NULL&#xa;   | total_seats        : INT NOT NULL&#xa;   | registered_seats   : INT NOT NULL DEFAULT 0&#xa;----------------------------------------------------&#xa;Invariants: registered_seats &lt;= total_seats&#xa;Headroom: available_seats = total_seats - registered_seats" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#BAE6FD;align=left;spacingLeft=14;fontSize=12;fontColor=#0369A1;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="120" y="170" width="360" height="250" as="geometry" />
        </mxCell>

        <!-- Registration Entity -->
        <mxCell id="entity_reg" value="registrations&#xa;[Attendee RSVP Transactions]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16A34A;fontColor=#FFFFFF;fontStyle=1;fontSize=14;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="680" y="130" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="reg_fields" value="PK | id             : BIGINT AUTO_INCREMENT&#xa;FK | event_id       : INT NOT NULL&#xa;   | attendee_name  : VARCHAR(100) NOT NULL&#xa;   | attendee_email : VARCHAR(150) NOT NULL&#xa;   | department     : VARCHAR(80) NOT NULL&#xa;   | tickets        : INT NOT NULL DEFAULT 1&#xa;   | registered_at  : TIMESTAMP DEFAULT CURRENT_TIMESTAMP&#xa;----------------------------------------------------&#xa;FK Constraint: FOREIGN KEY (event_id) REFERENCES campus_events(id)&#xa;Check Constraint: CHECK (tickets IN (1, 2))&#xa;Unique Constraint: UNIQUE KEY uk_event_email (event_id, attendee_email)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#BBF7D0;align=left;spacingLeft=14;fontSize=12;fontColor=#15803D;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="680" y="170" width="380" height="250" as="geometry" />
        </mxCell>

        <!-- Relationship Line -->
        <mxCell id="rel_1_to_n" value="1 to Many (1 : N)&#xa;One Event has Many Registrations&#xa;ON DELETE CASCADE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=2;fontColor=#0F172A;fontSize=12;fontStyle=1;" edge="1" parent="1" source="event_fields" target="reg_fields">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Seed Data Callout -->
        <mxCell id="seed_callout" value="Sample Seed Data:&#xa;• Event 1: Generative AI Bootcamp (100 total, 78 registered, 22 available)&#xa;• Event 2: 36-Hour Hackathon (150 total, 142 registered, 8 available)&#xa;• Event 3: LLM Fine-Tuning (60 total, 58 registered, 2 available)&#xa;• Event 4: Computer Vision &amp; Robotics (45 total, 45 registered, SOLD OUT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;align=left;spacingLeft=12;fontSize=12;fontColor=#92400E;" vertex="1" parent="1">
          <mxGeometry x="120" y="450" width="940" height="90" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- PAGE 3: REQUEST & LIFECYCLE SEQUENCE FLOW -->
  <diagram id="page-seq" name="3. RSVP Request Sequence Flow">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="seq_title" value="End-to-End RSVP Lifecycle: Reservation, Duplicate Detection, &amp; Seat Restoration" style="text;html=1;strokeColor=#CBD5E1;fillColor=#F8FAFC;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="150" y="20" width="870" height="50" as="geometry" />
        </mxCell>

        <!-- Actor / Components -->
        <mxCell id="act_student" value="Student / Attendee" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="130" height="530" as="geometry" />
        </mxCell>
        <mxCell id="act_ui" value="Frontend (Port 5500)&#xa;Vanilla JS Client" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#BAE6FD;strokeColor=#0284C7;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="90" width="150" height="530" as="geometry" />
        </mxCell>
        <mxCell id="act_api" value="Spring Boot 3 (Port 8080)&#xa;RsvpService (@Transactional)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#BBF7D0;strokeColor=#16A34A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="90" width="190" height="530" as="geometry" />
        </mxCell>
        <mxCell id="act_db" value="MySQL 8.4 (Port 3306)&#xa;InnoDB Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#FDE68A;strokeColor=#D97706;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="90" width="160" height="530" as="geometry" />
        </mxCell>

        <!-- Steps -->
        <!-- 1. Browse -->
        <mxCell id="msg_1" value="1. GET /api/events" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#0284C7;strokeWidth=2;fontStyle=1;" edge="1" parent="1" source="act_ui" target="act_api">
          <mxGeometry y="10" relative="1" as="geometry">
            <mxPoint x="400" y="160" as="sourcePoint" />
            <mxPoint x="670" y="160" as="targetPoint" />
            <Array as="points"><mxPoint x="530" y="160" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_2" value="SELECT * FROM campus_events" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#D97706;strokeWidth=2;" edge="1" parent="1" source="act_api" target="act_db">
          <mxGeometry y="10" relative="1" as="geometry">
            <mxPoint x="680" y="180" as="sourcePoint" />
            <mxPoint x="950" y="180" as="targetPoint" />
            <Array as="points"><mxPoint x="800" y="180" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_3" value="Render Workshop Cards &amp; Available Headroom Badges" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="act_ui" target="act_student">
          <mxGeometry y="10" relative="1" as="geometry">
            <mxPoint x="390" y="210" as="sourcePoint" />
            <mxPoint x="150" y="210" as="targetPoint" />
            <Array as="points"><mxPoint x="270" y="210" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- 2. Submit Reservation -->
        <mxCell id="msg_4" value="2. Select Workshop &amp; Submit RSVP (Name, Email, Dept, Tickets: 1–2)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#0F172A;strokeWidth=2;fontStyle=1;" edge="1" parent="1" source="act_student" target="act_ui">
          <mxGeometry y="10" relative="1" as="geometry">
            <mxPoint x="150" y="260" as="sourcePoint" />
            <mxPoint x="390" y="260" as="targetPoint" />
            <Array as="points"><mxPoint x="270" y="260" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_5" value="POST /api/registrations (JSON Payload)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#16A34A;strokeWidth=2;fontStyle=1;" edge="1" parent="1" source="act_ui" target="act_api">
          <mxGeometry y="10" relative="1" as="geometry">
            <mxPoint x="400" y="290" as="sourcePoint" />
            <mxPoint x="670" y="290" as="targetPoint" />
            <Array as="points"><mxPoint x="530" y="290" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- 3. Validation & Invariants -->
        <mxCell id="msg_6" value="Check uk_event_email &amp; check available headroom" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#D97706;strokeWidth=2;" edge="1" parent="1" source="act_api" target="act_db">
          <mxGeometry y="10" relative="1" as="geometry">
            <mxPoint x="680" y="320" as="sourcePoint" />
            <mxPoint x="950" y="320" as="targetPoint" />
            <Array as="points"><mxPoint x="800" y="320" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- 4a. Case: Duplicate Email -->
        <mxCell id="msg_dup" value="IF duplicate: Return HTTP 409 Conflict ('Duplicate Email')" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#DC2626;strokeWidth=2;fontColor=#DC2626;fontStyle=1;" edge="1" parent="1" source="act_api" target="act_ui">
          <mxGeometry y="10" relative="1" as="geometry">
            <mxPoint x="670" y="360" as="sourcePoint" />
            <mxPoint x="400" y="360" as="targetPoint" />
            <Array as="points"><mxPoint x="530" y="360" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- 4b. Case: Success -->
        <mxCell id="msg_7" value="IF valid: INSERT into registrations &amp; UPDATE campus_events SET registered_seats = registered_seats + tickets" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#16A34A;strokeWidth=2;" edge="1" parent="1" source="act_api" target="act_db">
          <mxGeometry y="10" relative="1" as="geometry">
            <mxPoint x="680" y="410" as="sourcePoint" />
            <mxPoint x="950" y="410" as="targetPoint" />
            <Array as="points"><mxPoint x="800" y="410" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_8" value="Return HTTP 201 Created (Registration Object)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#16A34A;strokeWidth=2;fontColor=#15803D;fontStyle=1;" edge="1" parent="1" source="act_api" target="act_ui">
          <mxGeometry y="10" relative="1" as="geometry">
            <mxPoint x="670" y="450" as="sourcePoint" />
            <mxPoint x="400" y="450" as="targetPoint" />
            <Array as="points"><mxPoint x="530" y="450" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_9" value="Show Success Modal &amp; Live Add to Headcount Roster Table" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="act_ui" target="act_student">
          <mxGeometry y="10" relative="1" as="geometry">
            <mxPoint x="390" y="480" as="sourcePoint" />
            <mxPoint x="150" y="480" as="targetPoint" />
            <Array as="points"><mxPoint x="270" y="480" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- 5. Cancellation -->
        <mxCell id="msg_10" value="3. One-Click Cancellation: DELETE /api/registrations/{id} &rarr; HTTP 204 &rarr; Restore Seats to Pool" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#7C3AED;strokeWidth=2;fontStyle=1;fontColor=#7C3AED;" edge="1" parent="1" source="act_ui" target="act_api">
          <mxGeometry y="10" relative="1" as="geometry">
            <mxPoint x="400" y="530" as="sourcePoint" />
            <mxPoint x="670" y="530" as="targetPoint" />
            <Array as="points"><mxPoint x="530" y="530" /></Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
