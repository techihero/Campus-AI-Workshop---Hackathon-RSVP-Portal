        <mxCell id="t2_controllers" value="REST Controllers&#xa;• RegistrationController&#xa;  - POST /api/registrations&#xa;  - GET /api/registrations&#xa;  - DELETE /api/registrations/{id}&#xa;• CampusEventController&#xa;  - GET /api/events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
