        <!-- Legend / Footer -->
        <mxCell id="legend" value="Security &amp; Invariants: (1) Constraint: UNIQUE(event_id, attendee_email) prevents duplicate student signups. (2) Atomic: registered_seats + tickets &lt;= total_seats checked in @Transactional. (3) Port separation: 5500 (UI) -> 8080 (REST) -> 3306 (MySQL)." style="text;html=1;strokeColor=#CBD5E1;fillColor=#F1F5F9;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontColor=#334155;" vertex="1" parent="1">
