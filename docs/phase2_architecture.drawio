        <mxCell id="tier3_header" value="Tier 3: Database Layer&#xa;MySQL 8.0 Community (:3306)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F59E0B;fontColor=#FFFFFF;fontStyle=1;fontSize=14;strokeColor=none;" vertex="1" parent="1">
