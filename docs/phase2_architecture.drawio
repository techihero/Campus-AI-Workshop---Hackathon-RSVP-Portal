        </mxCell>

        <mxCell id="t3_registrations" value="Table: registrations&#xa;----------------------------&#xa;• id: BIGINT AUTO_INCREMENT [PK]&#xa;• event_id: INT [FK]&#xa;• attendee_name: VARCHAR(100)&#xa;• attendee_email: VARCHAR(150)&#xa;• department: VARCHAR(80)&#xa;• tickets: INT (1 or 2)&#xa;• registered_at: TIMESTAMP&#xa;----------------------------&#xa;• UNIQUE(event_id, attendee_email)" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=0;align=left;fillColor=#FFFBEB;strokeColor=#FDE68A;fontSize=11;spacingLeft=8;" vertex="1" parent="1">
